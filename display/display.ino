void displayTask(void *pvParameters) {
  tft.init(240, 320);
  tft.setRotation(1);
  tft.fillScreen(ST77XX_BLACK);
  drawScreen(); // draw the static base once at startup

  unsigned long lastBaseUpdate = 0;
  unsigned long lastIconUpdate = 0;

  for (;;) {
    unsigned long now = millis();

    // Static base: redraw only once per second
    if (now - lastBaseUpdate >= 10000) {
      drawScreen();
      lastBaseUpdate = now;
    }

    // Animated icon: refresh independently at 8 Hz (125 ms)
    if (now - lastIconUpdate >= 125) {
      runIcon(flameIcon, tft);
      runIcon(fanIcon, tft);
      runIcon(humidifierIcon, tft);
      lastIconUpdate = now;
    }

    vTaskDelay(10 / portTICK_PERIOD_MS); // short yield, keeps both timers accurate
  }
}